{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler", 
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // Fixes the deprecation warning by pointing paths directly from the project root root
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts", 
    ".next/types/**/*.ts", 
    "src/**/*.ts", 
    "src/**/*.tsx", 
    "**/*.ts", 
    "**/*.tsx"
  ],
  "exclude": ["node_modules"]
}


